@model AuthenticationModel
@{
    ViewData["Title"] = "Register";
}
<div class="form-card narrow mx-auto">
    <h2 class="fw-bold mb-2">Join RaceDay</h2><p class="text-muted">Create your account and get ready to run.</p>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <form asp-action="Register" method="post">
        @foreach (var field in new[] { "Name", "Surname", "Email", "Cell_Number", "Password" })
        {
            <div class="mb-3">
                <label class="form-label" for="@field">@field.Replace("_", " ")</label>
                @if (field == "Password")
                {
                    <input class="form-control" type="password" id="@field" name="@field" />
                }
                else
                {

                    <input class="form-control" id="@field" name="@field" value="@Model.GetType().GetProperty(field)?.GetValue(Model)" />
                }
                <span asp-validation-for="@field" class="text-danger"></span>
            </div>
        }
        <div class="mb-3"><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select"><option>Participant</option><option>Organizer</option></select></div>
        <button class="btn btn-accent w-100">Create account</button>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
