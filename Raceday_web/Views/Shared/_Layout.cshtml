<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark race-navbar">
        <div class="container">
            @if (Context.Session.GetInt32("UserId") != null)
            {
                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Dashboard">🏃 RaceDay</a>
            }
            else
            {
                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">🏃 RaceDay</a>
            }
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    @if (Context.Session.GetInt32("UserId") != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Dashboard">Home</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">Home</a>
                        </li>
                    }
                    <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Events</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Categories" asp-action="Index">Categories</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Results" asp-action="Index">Results</a></li>
                    @if (Context.Session.GetInt32("UserId") != null)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index">My profile</a></li>
                        <li class="nav-item"><a class="btn btn-light btn-sm ms-lg-2" asp-controller="Authentication" asp-action="Logout">Logout</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Authentication" asp-action="Login">Login</a></li>
                        <li class="nav-item"><a class="btn btn-accent btn-sm ms-lg-2" asp-controller="Authentication" asp-action="Register">Join RaceDay</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    <main class="container py-4">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">@TempData["Message"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>
    <footer class="footer mt-5"><div class="container py-4 text-center">© @DateTime.Now.Year RaceDay · Run together. Go further.</div></footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
