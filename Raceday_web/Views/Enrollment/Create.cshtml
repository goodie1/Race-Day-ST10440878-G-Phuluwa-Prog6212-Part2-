@using RaceDay_web.Models
@model EnrollmentModel
@{
	ViewData["Title"] = "Enter a race";
}
<div class="form-card narrow">
	<h2 class="fw-bold mb-3">Enter a race</h2><p class="text-muted">Enter your account, category and event IDs.</p>
	<form asp-action="Create" method="post">
		<div class="mb-3"><label asp-for="Authentication_Id" class="form-label"></label><input asp-for="Authentication_Id" class="form-control" /></div>
		<div class="mb-3"><label asp-for="Category_Id" class="form-label"></label><input asp-for="Category_Id" class="form-control" /></div>
		<div class="mb-3"><label asp-for="Event_Id" class="form-label"></label><input asp-for="Event_Id" class="form-control" /></div>
		<button class="btn btn-accent">Register for race</button>
	</form>
</div>
